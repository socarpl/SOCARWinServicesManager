    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Socar.WinServicesManager.Cli</AssemblyName>
    <RootNamespace>Socar.WinServicesManager.Cli</RootNamespace>
    <Authors>SOCAR Software</Authors>
    <Company>SOCAR Software</Company>
