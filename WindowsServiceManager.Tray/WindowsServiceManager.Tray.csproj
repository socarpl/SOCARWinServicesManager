<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Socar.WinServicesManager.Tray</AssemblyName>
    <RootNamespace>Socar.WinServicesManager.Tray</RootNamespace>
    <Authors>SOCAR Software</Authors>
    <Company>SOCAR Software</Company>
    <Product>SOCAR WinServicesManager Tray</Product>
    <ApplicationIcon>..\Assets\gear_14964.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.15" />
  </ItemGroup>
  <ItemGroup>
    <None Include="service-manager.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\IpcMessages.cs" Link="Shared\IpcMessages.cs" />
    <Compile Include="..\ProfileModels.cs" Link="Shared\ProfileModels.cs" />
    <Compile Include="..\ProfileRepository.cs" Link="Shared\ProfileRepository.cs" />
    <Compile Include="..\ServiceModels.cs" Link="Shared\ServiceModels.cs" />
    <Compile Include="..\SharedRuntimeConfig.cs" Link="Shared\SharedRuntimeConfig.cs" />
  </ItemGroup>
</Project>
