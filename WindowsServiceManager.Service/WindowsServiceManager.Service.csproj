    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Socar.WinServicesManager.Service</AssemblyName>
    <RootNamespace>Socar.WinServicesManager.Service</RootNamespace>
    <Authors>SOCAR Software</Authors>
    <Company>SOCAR Software</Company>
    <Product>SOCAR WinServicesManager Service</Product>
